<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="carSpecification" class="com.setter.injection.Specification">
        <property name="make" value="BMW"></property>
        <property name="model" value="M5"></property>
    </bean>
    
    <bean id="myCar" class="com.setter.injection.Car">
        <!-- here inside this property, it should be ref not value, because we're referring to another bean -->
        <property name="specification" ref="carSpecification"/>
    </bean>

</beans>